{
  "name": "web",
  "$schema": "../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "kookio",
  "sourceRoot": "web/src",
  "tags": [],
  "targets": {
    "kookio-icons-filled": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vite-node --config vite.config.ts generate-icon-file.ts --namespace=kookio",
        "cwd": "web/scripts/",
        "parallel": false
      }
    },
    "material-icons-filled": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          { "command": "vite-node --config vite.config.ts import-material-icons.ts --style=filled" },
          { "command": "vite-node --config vite.config.ts generate-icon-file.ts --namespace=material" }
        ],
        "cwd": "web/scripts/",
        "parallel": false
      }
    },
    "build": {
      "executor": "@analogjs/platform:vite",
      "options": {
        "configFile": "web/vite.config.ts",
        "main": "web/src/main.ts",
        "outputPath": "dist/web/client",
        "tsConfig": "web/tsconfig.app.json",
        "implicitDependencies": ["prisma-client", "prisma-validator", "server-trpc", "shared-mock"]
      },
      "defaultConfiguration": "production",
      "configurations": {
        "development": {
          "mode": "development"
        },
        "production": {
          "sourcemap": false,
          "mode": "production"
        }
      },
      "outputs": ["{workspaceRoot}/dist/apps/web"]
    },
    "reset": {
      "executor": "nx:run-commands",
      "options": {
        "commands": [
          { "command": "nx reset" },
          { "command": "rimraf node_modules/.vite dist" }
        ]
      }
    },
    "serve": {
      "executor": "@analogjs/platform:vite-dev-server",
      "defaultConfiguration": "development",
      "options": {
        "buildTarget": "web:build",
        "port": 4200
      },
      "configurations": {
        "development": {
          "buildTarget": "web:build:development",
          "hmr": true
        },
        "production": {
          "buildTarget": "web:build:production"
        }
      }
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "web:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@analogjs/vitest-angular:test",
      "options": {
        "config": "vite.config.ts"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "web:build",
        "port": 4200,
        "staticFilePath": "dist/web/browser",
        "spa": true
      }
    }
  }
}
