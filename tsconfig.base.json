{
  "compileOnSave": false,
  "compilerOptions": {
    "rootDir": ".",
    "sourceMap": true,
    "declaration": false,
    "moduleResolution": "node",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "target": "es2022",
    "module": "esnext",
    "lib": ["es2022", "dom"],
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["apps/web/src/app/*"],
      "@kookio/core-config": ["libs/core/config/src/index.ts"],
      "@kookio/core-logging": ["libs/core/logging/src/index.ts"],
      "@kookio/core-security": ["libs/core/security/src/index.ts"],
      "@kookio/feature-auth": ["libs/feature/auth/src/index.ts"],
      "@kookio/feature-auth/testing": ["libs/feature/auth/src/testing.ts"],
      "@kookio/feature-dashboard": ["libs/feature/dashboard/src/index.ts"],
      "@kookio/feature-onboarding": ["libs/feature/onboarding/src/index.ts"],
      "@kookio/feature-onboarding/testing": [
        "libs/feature/onboarding/src/testing.ts"
      ],
      "@kookio/feature-pantry": ["libs/feature/pantry/src/index.ts"],
      "@kookio/feature-pantry/expiration": [
        "libs/feature/pantry/src/lib/utils/expiration.ts"
      ],
      "@kookio/feature-pantry/store": [
        "libs/feature/pantry/src/lib/store/pantry.store.ts"
      ],
      "@kookio/feature-pantry/trpc": [
        "libs/feature/pantry/src/lib/pantry-trpc.ts"
      ],
      "@kookio/feature-plan": ["libs/feature/plan/src/index.ts"],
      "@kookio/feature-plan/store": [
        "libs/feature/plan/src/lib/store/plan.store.ts"
      ],
      "@kookio/feature-plan/trpc": [
        "libs/feature/plan/src/lib/meal-plan-trpc.ts"
      ],
      "@kookio/feature-recipes": ["libs/feature/recipes/src/index.ts"],
      "@kookio/feature-recipes/cooking-trpc": [
        "libs/feature/recipes/src/lib/cooking-trpc.ts"
      ],
      "@kookio/feature-recipes/ingredient-confirm-dialog": [
        "libs/feature/recipes/src/lib/components/ingredient-confirm-dialog/ingredient-confirm-dialog.component.ts"
      ],
      "@kookio/feature-recipes/testing": [
        "libs/feature/recipes/src/testing.ts"
      ],
      "@kookio/feature-shell": ["libs/feature/shell/src/index.ts"],
      "@kookio/prisma-client": ["libs/prisma/client/src/index.ts"],
      "@kookio/prisma-client/*": ["libs/prisma/client/src/*"],
      "@kookio/prisma-client/server": ["libs/prisma/client/src/server.ts"],
      "@kookio/server-auth": ["libs/server/auth/src/index.ts"],
      "@kookio/server-logger": ["libs/server/logger/src/index.ts"],
      "@kookio/server-trpc": ["libs/server/trpc/src/index.ts"],
      "@kookio/server-trpc/*": ["libs/server/trpc/src/*"],
      "@kookio/shared-mock": ["libs/shared/mock/src/index.ts"],
      "@kookio/shared-ui": ["libs/shared/ui/src/index.ts"],
      "@kookio/shared-utility": ["libs/shared/utility/src/index.ts"],
      "@kookio/shared-utility/measure-units": [
        "libs/shared/utility/src/lib/labeling/measure-unit-labels.ts"
      ],
      "@server/*": ["apps/web/src/server/*"]
    }
  },
  "exclude": ["node_modules", "tmp"]
}
