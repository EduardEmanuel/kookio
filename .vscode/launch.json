{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug: web (Chrome)",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:4200",
      "webRoot": "${workspaceFolder}/apps/web/src",
      "sourceMapPathOverrides": {
        "/@fs/*": "/*",
        "/apps/web/src/*": "${workspaceFolder}/apps/web/src/*",
        "../../libs/*": "${workspaceFolder}/libs/*"
      },
      "pauseForSourceMap": true,
      "skipFiles": ["<node_internals>/**", "${workspaceFolder}/node_modules/**"]
    },
    {
      "name": "Debug: web (attach Chrome)",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/apps/web/src",
      "sourceMapPathOverrides": {
        "/@fs/*": "/*",
        "../../libs/*": "${workspaceFolder}/libs/*"
      }
    }
  ],
  "compounds": [
    {
      "name": "Serve + Debug",
      "configurations": ["Debug: web (Chrome)"],
      "preLaunchTask": "start:web"
    }
  ]
}
