{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "start:web",
      "type": "shell",
      "command": "npm run start:web",
      "isBackground": true,
      "problemMatcher": {
        "owner": "typescript",
        "pattern": {
          "regexp": "^(?:ERROR in )?(.+):(\\d+):(\\d+) - (error|warning) TS(\\d+): (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "Starting|Building|Compiling",
          "endsPattern": "Local:\\s+http://localhost"
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated"
      }
    }
  ]
}
