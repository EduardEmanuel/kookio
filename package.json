    "@nx/js": "22.7.5",
    "@nx/playwright": "22.7.5",
    "@nx/vite": "22.7.5",
    "@nx/vitest": "22.7.5",
    "@nx/web": "22.7.5",
    "@nx/workspace": "22.7.5",
    "@playwright/test": "~1.60.0",
    "@schematics/angular": "21.2.13",
    "@swc-node/register": "1.11.1",
    "@swc/core": "1.15.40",
    "@swc/helpers": "0.5.23",
    "@tailwindcss/vite": "~4.3.0",
    "@types/node": "~24.12.4",
    "@typescript-eslint/rule-tester": "~8.60.0",
    "@vitest/coverage-v8": "4.1.7",
    "@vitest/ui": "4.1.7",
    "angular-eslint": "21.4.0",
    "dotenv": "^17.4.2",
    "esbuild": "~0.25.12",
    "eslint": "~10.4.1",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-playwright": "~2.10.4",
    "eslint-plugin-prefer-arrow": "^1.2.3",
    "husky": "^9.1.7",
    "jiti": "~2.7.0",
    "jsdom": "~29.1.1",
    "jsonc-eslint-parser": "~3.1.0",
    "lint-staged": "^17.0.6",
    "nx": "22.7.5",
    "pino-pretty": "^13.1.3",
    "postcss": "~8.5.6",
    "prettier": "~3.8.3",
    "prisma": "~7.8.0",
    "prisma-zod-generator": "~2.1.4",
