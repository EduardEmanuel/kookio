    "@angular/router": "21.2.15",
    "@ngrx/signals": "^21.1.0",
    "@prisma/adapter-pg": "~7.8.0",
    "@trpc/client": "~10.45.2",
    "@trpc/server": "~10.45.2",
    "firebase": "^12.14.0",
    "firebase-admin": "^13.10.0",
    "front-matter": "~4.0.2",
    "isomorphic-fetch": "~3.0.0",
    "marked": "~15.0.12",
    "marked-gfm-heading-id": "~4.1.4",
    "marked-highlight": "~2.2.4",
    "marked-mangle": "~1.1.13",
    "ngx-skeleton-loader": "^12.0.0",
    "pino": "~10.3.1",
    "prismjs": "~1.30.0",
    "redis": "^6.0.0",
    "rxjs": "~7.8.2",
    "superjson": "~2.2.6",
    "zod": "~4.4.3",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
