{
  "name": "@kookio/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.19.0 <25",
    "npm": ">=10.0.0 <12"
  },
  "type": "module",
  "scripts": {
    "bench:preview": "tsx scripts/with-vercel-env.ts --env=preview -- tsx ./scripts/bench-preview.ts",
    "db:bootstrap": "npm run with:env -- --env=development -- tsx scripts/bootstrap-cockroach.ts",
    "setup:ai": "tsx scripts/setup-ai-symlinks.ts --targets=AGENTS.md,CLAUDE.md,GEMINI.md,.github/copilot-instructions.md",
    "ping:redis": "npm run with:env -- --env=development -- tsx scripts/ping-redis.ts",
    "reset-user-password": "npm run with:env -- --env=development -- tsx scripts/reset-user-password.ts",
    "with:env": "tsx ./scripts/with-vercel-env.ts",
    "start:web": "npm run with:env -- --env=development -- nx serve web",
    "build:web": "npm run with:env -- --env=production -- nx build web",
    "e2e:web": "npm run with:env -- --env=development -- nx e2e web-e2e",
    "e2e:web-report": "npm run with:env -- --env=preview -- nx e2e-report web-e2e",
    "migrate-deploy:prisma-client": "npm run with:env -- --env=development -- nx migrate-deploy prisma-client",
    "migrate-dev:prisma-client": "npm run with:env -- --env=development -- nx migrate-dev prisma-client",
    "migrate-dev-create-only:prisma-client": "npm run with:env -- --env=development -- nx migrate-dev-create-only prisma-client",
    "seed:prisma-client": "npm run with:env -- --env=development nx seed prisma-client",
    "studio:prisma-client": "npm run with:env -- --env=development nx studio prisma-client",
    "kookio-icons-filled:web": "nx kookio-icons-filled web",
    "build:icons": "tsx scripts/build-material-symbols-icons.ts",
    "build:icons:check": "tsx scripts/build-material-symbols-icons.ts --check",
    "build:twemoji": "tsx scripts/build-twemoji.ts",
    "build:twemoji:check": "tsx scripts/build-twemoji.ts --check",
    "build:pwa-icons": "tsx scripts/build-pwa-icons.ts",
    "eslint:fix": "eslint . --fix",
    "lint:all:fix": "nx run-many -t lint --fix",
    "test:all": "nx run-many -t test",
    "affected": "nx show projects --affected",
    "test:affected": "nx affected -t test --parallel=3",
    "build:affected": "nx affected -t build --parallel=3",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "reset": "nx reset",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,html,css,scss,yml,yaml}": [
      "npx nx format:write --files",
      "npx eslint --fix"
    ]
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "2.5.2",
    "@analogjs/platform": "2.5.2",
    "@analogjs/router": "2.5.2",
    "@analogjs/trpc": "~0.5.0",
    "@angular/cdk": "21.2.13",
    "@angular/common": "21.2.15",
    "@angular/compiler": "21.2.15",
