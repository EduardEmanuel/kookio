{
  "name": "@kookio/source",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20.11.1 <25",
    "npm": ">=10.0.0 <12"
  },
  "scripts": {
    "bench:preview": "node ./scripts/with-vercel-env.mjs --env=preview -- node ./scripts/bench-preview.mjs",
    "with:env": "node ./scripts/with-vercel-env.mjs",
    "start:web": "npm run with:env -- --env=development -- nx serve web",
    "build:web": "npm run with:env -- --env=production -- nx build web",
    "e2e:web": "npm run with:env -- --env=preview -- nx e2e web-e2e",
    "e2e:web-report": "npm run with:env -- --env=preview -- nx e2e-report web-e2e",
    "migrate-dev:prisma-client": "npm run with:env -- --env=development -- nx migrate-dev prisma-client",
    "migrate-deploy:prisma-client": "npm run with:env -- --env=production -- nx migrate-deploy prisma-client",
    "seed:prisma-client": "npm run with:env -- --env=development nx seed prisma-client",
    "studio:prisma-client": "npm run with:env -- --env=development nx studio prisma-client",
    "kookio-icons-filled:web": "nx kookio-icons-filled web",
    "material-icons-filled:web": "nx material-icons-filled web",
    "eslint:fix": "eslint . --fix",
    "lint:all:fix": "nx run-many -t lint --fix",
    "test:all": "nx run-many -t test",
    "affected": "nx show projects --affected",
    "test:affected": "nx affected -t test --parallel=3",
    "build:affected": "nx affected -t build --parallel=3",
    "format:write": "nx format:write",
    "format:check": "nx format:check",
    "reset": "nx reset",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs,json,md,html,css,scss,yml,yaml}": [
      "npx nx format:write --files",
      "npx eslint --fix"
    ]
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "~1.21.0",
    "@analogjs/platform": "~1.21.0",
    "@analogjs/router": "~1.21.0",
