  "scripts": {
    "start:web": "nx serve web",
    "build:web": "nx build web",
    "test:web": "nx test web",
    "lint:web": "nx lint web",
    "e2e:web": "npm run vercel:env:tmp && dotenv -e ./tmp/kookio.env -- nx e2e web-e2e && rimraf ./tmp/kookio.env",
    "test:prisma-client": "nx test prisma-client",
    "migrate-dev:prisma-client": "npm run vercel:env:tmp && dotenv -e ./tmp/kookio.env -- nx migrate-dev prisma-client && rimraf ./tmp/kookio.env",
    "migrate-deploy:prisma-client": "npm run vercel:env:tmp && dotenv -e ./tmp/kookio.env -- nx migrate-deploy prisma-client && rimraf ./tmp/kookio.env",
    "bench-latency:prisma-client": "npm run vercel:env:tmp && dotenv -e ./tmp/kookio.env -- nx bench-latency prisma-client && rimraf ./tmp/kookio.env",
    "seed:prisma-client": "npm run vercel:env:tmp && dotenv -e ./tmp/kookio.env -- nx seed prisma-client && rimraf ./tmp/kookio.env",
    "studio:prisma-client": "npm run vercel:env:tmp && dotenv -e ./tmp/kookio.env -- nx studio prisma-client && rimraf ./tmp/kookio.env",
    "reset:web": "nx reset web",
    "kookio-icons-filled:web": "nx kookio-icons-filled web",
    "material-icons-filled:web": "nx material-icons-filled web",
    "affected": "nx show projects --affected",
    "format": "nx format:write",
    "safe-install": "npm ci --legacy-peer-deps",
    "vercel:env:tmp": "vercel env pull ./tmp/kookio.env"
  },
  "private": true,
