# Example environment file for Prisma & Kookio project
# Copy this to `.env.local` or `.env.cloud` and replace placeholders.

# PostgreSQL connection string (compatible with CockroachDB)
# Format: "postgresql://USER:PASS@HOST:26257/kookio?sslmode=require&options=--cluster%3DCLUSTER_NAME"
DATABASE_URL="postgresql://USER:PASS@HOST:26257/kookio?sslmode=require&options=--cluster%3DCLUSTER_NAME"

# Optionally, for Prisma Cloud connection (Railway, Supabase, etc.)
# Format: prisma+postgres://HOST:PORT/?api_key=YOUR_KEY
# DATABASE_URL="prisma+postgres://HOST:PORT/?api_key=YOUR_KEY"