// Kookio — Prisma Schema
// Updated: April 2026
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider         = "prisma-zod-generator"
  output           = "./src/prisma-zod-generator"
  useMultipleFiles = true // generate a separate file for each model
  useTimestamps    = true // use `z.date()` for DateTime fields instead of `z.string()`
  useBigInt        = true // use `z.bigint()` for BigInt fields instead of `z.number()`
  useDecimal       = true // use `z.instanceof(Decimal)` for Decimal fields instead of `z.number()`
}

datasource db {
  provider  = "cockroachdb"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_DATABASE_URL")
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum RecipeStatus {
  PUBLIC
  PRIVATE
}

enum MealSlotType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
}

/// Normalized units of measure for recipe ingredients.
/// Raw strings from TheMealDB are parsed into these values during seed.
enum MeasureUnit {
  G
  KG
  ML
  L
  TSP
  TBSP
  CUP
  OZ
  LB
  PIECE
  SLICE
  CLOVE
  BUNCH
  PINCH
  TO_TASTE
  TO_SERVE
  GARNISH
  OTHER
}

/// Controlled vocabulary for ingredient categories.
/// Managed by Kookio — users cannot define their own.
enum IngredientCategory {
  MEAT
  FISH
  DAIRY
  PRODUCE
  GRAINS
  LEGUMES
  SPICES
  CONDIMENTS
  HERBS
  NUTS
  BEVERAGES
  SWEETS
  OTHER
}

// ─────────────────────────────────────────────
// IDENTITY & AUTH
// ─────────────────────────────────────────────

/// User identity & authorization state.
/// Field names align with OIDC where relevant (e.g., AMR).
/// Intentionally separate from UserProfile: this model owns authentication
/// and authorization concerns only. Application-level preferences (household
/// size, dietary restrictions, utensils, onboarding state) live in UserProfile,
/// following the Single Responsibility Principle and keeping auth concerns
/// isolated from product concerns. UserProfile is optional/null until the
/// onboarding flow is completed.
model User {
  /// Primary key (UUID v4).
  id String @id @default(uuid())

  /// Unique email address (natural identifier).
  email String @unique

  /// Unique ID for firebase auth.
  firebaseUid String? @unique

  /// Optional display name.
  name String?

  /// Authentication Methods References — OIDC AMR claim (RFC 8176).
  /// Stored as a String array (e.g. ["password"]) following the
  /// OIDC specification, which defines AMR as a JSON array of strings.
  /// Deliberate denormalization: extracting into a junction table would add
  /// join overhead with no query benefit, as AMR values are always read and
  /// written together as a set bound to a single authentication event.
  amr String[] @default([])

  /// Soft-disable flag (revokes access without deletion).
  isDisabled Boolean @default(false)

  /// Soft-delete timestamp; null means active.
  deletedAt DateTime?

  /// Creation timestamp (server-side).
  createdAt DateTime @default(now())

  /// Last update timestamp (server-side).
  updatedAt DateTime @updatedAt

  /// User profile & onboarding preferences.
  profile UserProfile?

  /// Pantry items (ingredients in stock).
  pantryItems PantryItem[]

  /// Recipes authored by this user.
  recipes Recipe[]

  /// Recipe collections (replaces SavedRecipe).
  collections RecipeCollection[]

  /// Planned meals on the user's timeline. There is no parent "MealPlan"
  /// row — slots stand alone, one per (date, slotType) pair, and the UI
  /// navigates the timeline freely with no enforced range.
  mealSlots MealSlot[]

  /// Cooking sessions recorded by this user.
  cookingSessions CookingSession[]

  /// Onboarding meal-category preferences ("Categories" subtab on the fridge step).
  preferredCategories UserPreferredCategory[]

  /// Onboarding meal-area preferences ("Cuisines" subtab on the fridge step).
  preferredAreas UserPreferredArea[]

  @@index([email], map: "idx_user_email")
}

// ─────────────────────────────────────────────
// USER PROFILE & ONBOARDING
// ─────────────────────────────────────────────

/// Application-level preferences and onboarding state for a user.
/// Intentionally separate from User, which owns identity and authentication.
/// This model is optional/null until the onboarding flow is completed,
/// allowing the system to distinguish between a registered-but-not-onboarded
/// user and a fully configured one without nullable columns on User itself.
model UserProfile {
  id            String @id @default(uuid())
  userId        String @unique
  adultsCount   Int    @default(1)
  childrenCount Int    @default(0)

  /// Whether the user has completed the onboarding flow.
  onboardingDone Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  dietaryRestrictions UserDietaryRestriction[]
  utensils            UserUtensil[]
}

/// Controlled list of dietary restrictions.
/// Seeded by Kookio — not user-defined.
model DietaryRestriction {
  id String @id @default(uuid())

  /// Machine-readable identifier e.g. "gluten-free", "vegan".
  slug String @unique

  /// Human-readable label.
  label String

  /// Emoji for UI display.
  emoji String?

  description String?

  users UserDietaryRestriction[]
}

model UserDietaryRestriction {
  userId               String
  dietaryRestrictionId String

  user        UserProfile        @relation(fields: [userId], references: [id], onDelete: Cascade)
  restriction DietaryRestriction @relation(fields: [dietaryRestrictionId], references: [id])

  @@id([userId, dietaryRestrictionId])
}

/// Controlled list of kitchen utensils.
/// Seeded by Kookio — not user-defined.
/// TheMealDB does not provide utensil data.
model Utensil {
  id    String  @id @default(uuid())
  slug  String  @unique
  name  String
  emoji String?

  /// e.g. "cutting", "cooking", "baking", "measuring"
  category String?

  users UserUtensil[]
}

model UserUtensil {
  userId    String
  utensilId String

  user    UserProfile @relation(fields: [userId], references: [id], onDelete: Cascade)
  utensil Utensil     @relation(fields: [utensilId], references: [id])

  @@id([userId, utensilId])
}

// ─────────────────────────────────────────────
// CATALOG (seeded from TheMealDB, read-only)
// ─────────────────────────────────────────────

/// Meal categories sourced from TheMealDB (e.g. Beef, Dessert, Seafood).
model MealCategory {
  id String @id @default(uuid())

  /// TheMealDB strCategory slug — unique identifier from external source.
  externalId String @unique

  name        String
  emoji       String?
  imageUrl    String?
  description String?

  createdAt DateTime @default(now())

  recipes          Recipe[]
  preferredByUsers UserPreferredCategory[]
}

/// Junction table — meal categories a user picked during onboarding.
/// Owned directly by User (not UserProfile) so preferences survive profile resets.
model UserPreferredCategory {
  userId         String
  mealCategoryId String

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealCategory MealCategory @relation(fields: [mealCategoryId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, mealCategoryId])
  @@index([userId], map: "idx_user_pref_category_user")
  @@map("user_preferred_categories")
}

/// Geographic areas sourced from TheMealDB (e.g. Italian, Japanese).
model MealArea {
  id String @id @default(uuid())

  /// TheMealDB strArea slug — unique identifier from external source.
  externalId String @unique

  name String
  flag String?

  createdAt DateTime @default(now())

  recipes          Recipe[]
  preferredByUsers UserPreferredArea[]
}

/// Junction table — meal areas (cuisines) a user picked during onboarding.
/// Owned directly by User (not UserProfile) so preferences survive profile resets.
model UserPreferredArea {
  userId     String
  mealAreaId String

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  mealArea MealArea @relation(fields: [mealAreaId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([userId, mealAreaId])
  @@index([userId], map: "idx_user_pref_area_user")
  @@map("user_preferred_areas")
}

/// Master ingredient catalog, seeded from TheMealDB and normalized.
model IngredientCatalog {
  id String @id @default(uuid())

  /// TheMealDB ingredient ID, if sourced externally.
  externalId String? @unique

  name           String
  normalizedName String              @unique
  description    String?
  imageUrl       String?
  category       IngredientCategory?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeIngredients RecipeIngredient[]
  pantryItems       PantryItem[]
}

// ─────────────────────────────────────────────
// RECIPES
// ─────────────────────────────────────────────

model Recipe {
  id String @id @default(uuid())

  /// TheMealDB idMeal — null for user-authored recipes.
  externalId String? @unique

  slug         String       @unique
  title        String
  description  String?
  imageUrl     String?
  youtubeUrl   String?
  sourceUrl    String?
  instructions String
  status       RecipeStatus @default(PUBLIC)
  servings     Int          @default(4)

  /// TheMealDB does not provide these — populated manually or via AI post-licență.
  prepTimeMinutes Int?
  cookTimeMinutes Int?

  categoryId String?
  areaId     String?
  authorId   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  category MealCategory? @relation(fields: [categoryId], references: [id])
  area     MealArea?     @relation(fields: [areaId], references: [id])
  author   User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  ingredients       RecipeIngredient[]
  tags              RecipeTag[]
  collectionEntries RecipeCollectionEntry[]
  mealSlots         MealSlot[]
  cookingSessions   CookingSession[]

  @@index([status])
  @@index([categoryId])
  @@index([areaId])
  @@index([authorId])
  @@index([externalId])
}

/// Junction table between Recipe and IngredientCatalog.
/// Units are normalized during seed — no raw strings stored.
model RecipeIngredient {
  id                  String       @id @default(uuid())
  recipeId            String
  ingredientCatalogId String
  quantity            Float?
  unit                MeasureUnit?

  /// Describes the ingredient *in the context of this recipe*, not the ingredient itself.
  /// Correctly placed here (not on IngredientCatalog) as it depends on the
  /// (recipe, ingredient) pair — e.g. "chopped", "heaped", "to taste".
  notes String?

  recipe     Recipe            @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredient IngredientCatalog @relation(fields: [ingredientCatalogId], references: [id])

  @@unique([recipeId, ingredientCatalogId])
  @@index([recipeId])
  @@index([ingredientCatalogId])
}

/// Normalized tags for a recipe.
/// Extracted from TheMealDB strTags during seed.
/// Replaces the denormalized `tags String[]` field to satisfy 1NF.
model RecipeTag {
  id       String @id @default(uuid())
  recipeId String
  tag      String

  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@unique([recipeId, tag])
  @@index([recipeId])
  @@index([tag])
}

// ─────────────────────────────────────────────
// PANTRY
// ─────────────────────────────────────────────

/// A user's current stock of a specific ingredient.
model PantryItem {
  id                  String      @id @default(uuid())
  userId              String
  ingredientCatalogId String
  quantity            Float
  unit                MeasureUnit
  expiresAt           DateTime?

  addedAt   DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient IngredientCatalog @relation(fields: [ingredientCatalogId], references: [id])

  @@unique([userId, ingredientCatalogId])
  @@index([userId])
  @@index([expiresAt]) // for expiry notifications
}

// ─────────────────────────────────────────────
// RECIPE COLLECTIONS (replaces SavedRecipe)
// ─────────────────────────────────────────────

/// A named collection of recipes owned by a user.
/// Two default collections are created at onboarding: "Favorite" and "De încercat".
model RecipeCollection {
  id     String  @id @default(uuid())
  userId String
  name   String
  emoji  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipes RecipeCollectionEntry[]

  @@unique([userId, name])
  @@index([userId])
}

model RecipeCollectionEntry {
  collectionId String
  recipeId     String
  addedAt      DateTime @default(now())

  collection RecipeCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  recipe     Recipe           @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@id([collectionId, recipeId])
}

// ─────────────────────────────────────────────
// MEAL SLOTS
// ─────────────────────────────────────────────

/// A single planned meal on the user's timeline. There is no parent
/// "plan" row — `MealSlot` is the entire data model for the planner.
/// One row per (userId, date, slotType) triple; empty cells are absent
/// rather than represented as `recipeId = null`. The UI navigates the
/// timeline freely with no enforced range, so the schema imposes none.
model MealSlot {
  id        String       @id @default(uuid())
  userId    String
  recipeId  String?
  date      DateTime
  slotType  MealSlotType
  servings  Int          @default(1)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe? @relation(fields: [recipeId], references: [id], onDelete: SetNull)

  @@unique([userId, date, slotType])
  @@index([userId, date])
}

// ─────────────────────────────────────────────
// COOKING SESSION
// ─────────────────────────────────────────────

/// Records a user cooking a recipe.
/// completedAt being non-null triggers pantry deduction.
/// Enables "how many times have you cooked X" queries.
model CookingSession {
  id       String @id @default(uuid())
  userId   String
  recipeId String
  servings Int

  /// Null = session started but not finished — pantry is NOT deducted.
  completedAt DateTime?

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipe Recipe @relation(fields: [recipeId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([recipeId])
  @@index([userId, recipeId]) // for "how many times cooked" queries
}
