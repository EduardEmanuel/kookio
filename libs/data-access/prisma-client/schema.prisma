// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

generator zod {
  provider = "prisma-zod-generator"
  output   = "../prisma-validator/src/generated/zod"
  useMultipleFiles = true  // generate a separate file for each model
  useTimestamps = true     // use `z.date()` for DateTime fields instead of `z.string()`
  useBigInt = true         // use `z.bigint()` for BigInt fields instead of `z.number()`
  useDecimal = true        // use `z.instanceof(Decimal)` for Decimal fields instead of `z.number()`
}

datasource db {
  provider = "cockroachdb"
  url      = env("DATABASE_URL")
}

model Ingredient {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  quantity  Int
  unit      String
  optional  Boolean
  userId    String
  createdAt DateTime @default(now())
  @@unique([userId, name]) 
}

