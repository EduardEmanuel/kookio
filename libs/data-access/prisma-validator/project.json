{
  "name": "prisma-validator",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/data-access/prisma-validator/src",
  "projectType": "library",
  "tags": ["type:data-access", "scope:prisma"],
  "targets": {
    "build": {
      "executor": "@nx/esbuild:esbuild",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/data-access/prisma-validator",
        "main": "libs/data-access/prisma-validator/src/index.ts",
        "tsConfig": "libs/data-access/prisma-validator/tsconfig.lib.json",
        "assets": ["libs/data-access/prisma-validator/*.md"],
        "format": ["cjs"],
        "generatePackageJson": true
      }
    }
  }
}
