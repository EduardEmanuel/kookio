{
  "name": "ui",
  "$schema": "../../../node_modules/nx/schemas/project-schema.json",
  "sourceRoot": "libs/shared/ui/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:frontend", "type:ui"],
  "targets": {
    "build": {
      "executor": "@nx/js:tsc",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/libs/shared/ui",
        "main": "libs/shared/ui/src/index.ts",
        "tsConfig": "libs/shared/ui/tsconfig.lib.json",
        "assets": ["libs/shared/ui/*.md"]
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/vite:test"
    },
    "build-tokens": {
      "executor": "nx:run-commands",
      "cache": false,
      "options": {
        "cwd": ".",
        "commands": [
          {
            "command": "cat libs/shared/ui/src/styles/_tokens.scss libs/shared/ui/src/styles/_m3-light.scss libs/shared/ui/src/styles/_m3-dark.scss libs/shared/ui/src/styles/_m3-light-mc.scss libs/shared/ui/src/styles/_m3-light-hc.scss libs/shared/ui/src/styles/_m3-dark-mc.scss libs/shared/ui/src/styles/_m3-dark-hc.scss > apps/web/src/styles/kookio-tokens.css"
          },
          {
            "command": "cat libs/shared/ui/src/styles/_material-overrides.scss > apps/web/src/styles/kookio-material.css"
          }
        ]
      }
    }
  }
}
